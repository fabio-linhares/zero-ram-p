# packaging/dkms/dkms.conf.template
# Configuração DKMS para o Módulo de Kernel Zero RAM (Rework de zcomp v2)

PACKAGE_NAME="zero-ram"
PACKAGE_VERSION="2.0"
BUILT_MODULE_NAME[0]="zram"
DEST_MODULE_LOCATION[0]="/updates/dkms"
MAKE[0]="make KDIR=/lib/modules/$kernelver/build"
CLEAN="make KDIR=/lib/modules/$kernelver/build clean"
AUTOINSTALL="yes"
